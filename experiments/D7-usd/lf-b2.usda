#usda 1.0

over "Diagram"
{
    over "api"
    {
        double3 xformOp:translate = (100, 100, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    over "auth"
    {
        double3 xformOp:translate = (999, 999, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    over "db"
    {
        double3 xformOp:translate = (400, 500, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    over "queue"
    {
        double3 xformOp:translate = (700, 300, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
